# ---- Required for wallets ----------------------------------------------------
# Public HTTPS base URL of THIS deployment, no trailing slash.
# Local test with a tunnel: the https URL printed by ngrok / cloudflared.
# Render: https://<service-name>.onrender.com
BASE_URL=http://localhost:3000
PORT=3000

# ---- Request format ----------------------------------------------------------
# reference (default): QR holds a short request_uri -> small, easy-to-scan QR code.
# value: QR holds the whole request (about 1100-1700 characters -> dense QR; legacy wallets only).
QR_MODE=reference

# pex  = Presentation Exchange (presentation_definition), OpenID4VP drafts <= 21
# dcql = DCQL (dcql_query), OpenID4VP 1.0
QUERY_LANGUAGE=pex

# client_id sent to the wallet when the request is not signed.
CLIENT_ID=sample-rp-benin
# Optional draft client_id_scheme, e.g. redirect_uri (then client_id = response_uri). Empty = not sent.
CLIENT_ID_SCHEME=

# ---- Credential profiles (align with your issuer) ---------------------------
# PID_DOCTYPE=eu.europa.ec.eudi.pid.1
# PID_NAMESPACE=eu.europa.ec.eudi.pid.1
# BIRTH_CERT_DOCTYPE=bj.gouv.birth_certificate.1     # PLACEHOLDER: use your issuer's doctype
# BIRTH_CERT_NAMESPACE=bj.gouv.birth_certificate.1

# ---- Optional: signed requests (client_id = x509_san_dns:<host>) ------------
# Generate a test pair with: npm run gen-cert
# RP_SIGNING_KEY_FILE=keys/rp-key.pem
# RP_SIGNING_CERT_FILE=keys/rp-cert.pem

# ---- Optional: issuer trust --------------------------------------------------
# Directory with PEM files of trusted issuer root certificates (IACA).
# TRUSTED_ISSUER_CERTS_DIR=trusted-issuers
# false = reject credentials whose issuer chain is not validated against the trust anchors above.
ALLOW_UNTRUSTED_ISSUER=true
